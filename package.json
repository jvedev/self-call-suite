{
  "name": "self-call-suite",
  "version": "1.0.0",
  "private": true,
  "description": "Suite of apps for self-call HEMA system",
  "workspaces": [
    "shared/*",
    "apps/*"
  ],
  "scripts": {
    "build:tests": "cd apps/tests && npm run build && cd ../..",
    "build:suite": "cd apps/suite && npm run build && cd ../..",
    "dev:suite": "cd apps/suite && npm run dev",
    "dev": "cd apps/suite && npm run dev"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "jest": "^29.5.0",
    "typescript": "^5.0.0",
    "vite": "^7.1.11",
    "vite-plugin-static-copy": "^3.1.4"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.89.0",
    "path": "^0.12.7",
    "valtio": "^1.11.2"
  }
}
