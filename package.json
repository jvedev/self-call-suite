{
  "name": "self-call-suite",
  "version": "1.0.0",
  "description": "Suite of apps for self call HEMA system",
  "type": "module",
  "workspaces": [
    "shared/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "echo 'Use npm run dev:self-call or npm run dev:server'",
    "dev:self-call": "cd apps/self-call && npm run dev",
    "dev:server": "cd apps/server && npm run dev", 
    "dev:scoreboard": "cd apps/scoreboard && npm run dev",
    "build": "npm run build:shared && npm run build:apps",
    "build:shared": "cd shared/modules && npm run build && cd ../views && npm run build && cd ../web-components && npm run build",
    "build:apps": "cd apps/self-call && npm run build",
    "build:server": "cd apps/server && npm run build",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "clean": "npm run clean --workspaces --if-present",
    "setup": "npm install && npm run build:shared"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "concurrently": "^8.2.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jvedev/self-call-suite.git"
  },
  "license": "MIT",
  "private": true
}