{
  "name": "self-call-suite",
  "version": "1.0.0",
  "private": true,
  "description": "Suite of apps for self-call HEMA system",
  "workspaces": [
    "shared/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/self-call",
    "dev:self-call": "npm run dev --workspace=apps/self-call",
    "dev:scoreboard": "npm run dev --workspace=apps/scoreboard",
    "dev:scorekeeper": "npm run dev --workspace=apps/scoreKeeper",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "dev:server": "npm run dev --workspace=apps/server",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "install:all": "npm install --workspaces"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "jest": "^29.5.0",
    "typescript": "^5.0.0",
    "vite": "^7.1.11"
  },
  "dependencies": {
    "valtio": "^1.11.2"
  }
}
