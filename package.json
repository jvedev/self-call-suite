{
  "name": "self-call-suite",
  "version": "1.0.0",
  "description": "Suite of apps for self call HEMA system",
  "type": "module",
  "workspaces": [
    "shared/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:shared\" \"npm run dev:apps\"",
    "dev:shared": "npm run dev --workspaces --if-present --workspace=shared/*",
    "dev:apps": "npm run dev --workspaces --if-present --workspace=apps/*",
    "build": "npm run build --workspaces --if-present",
    "build:shared": "npm run build --workspaces --if-present --workspace=shared/*",
    "build:apps": "npm run build --workspaces --if-present --workspace=apps/*",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "concurrently": "^8.2.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jvedev/self-call-suite.git"
  },
  "license": "MIT",
  "private": true
}